# Signing key — SECRET. Losing/rotating it changes the extension ID.
build/key.pem
build/*.pem

# Build artifacts. dist/ is committed (crx + extension.json + updates.xml) so
# force-install works from GitHub over https and installs are build-tool-free.
build/staging/
build/*.crx
build/*.reg
build/staging-firefox/
web-ext-artifacts/

# OS / editor cruft
Thumbs.db
.DS_Store

# npm (tests only; tldts is vendored into src/ext)
node_modules/
package-lock.json

# Working docs (specs, plans, reviews, test log): local only, never committed
docs/
