build/key.pem
build/*.pem

# Build artifacts. dist/ is committed (on this branch: the Firefox XPI + updates.json)
# so installs are build-tool-free.
build/staging/
build/*.crx
build/*.reg
build/staging-firefox/
web-ext-artifacts/

# OS / editor cruft
Thumbs.db
.DS_Store

# npm (tests only; tldts is vendored into src/ext)
node_modules/
package-lock.json

# Working docs (specs, plans, reviews, test log): local only, never committed
docs/
